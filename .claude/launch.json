{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bookmark-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bookmark/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "bookmark-dev-isolated",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bookmark/web",
        "dev:isolated"
      ],
      "port": 3010,
      "autoPort": true
    },
    {
      "name": "bookmark-running",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "bookmark-test",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bookmark/web",
        "dev:test"
      ],
      "port": 3030
    },
    {
      "name": "bookmark-test-3031",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bookmark/web",
        "dev:test:3031"
      ],
      "port": 3031
    },
    {
      "name": "bookmark-mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bookmark/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
