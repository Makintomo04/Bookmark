// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.String
  access_token       String?  @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String  @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One signed-in phone. The app holds a refresh token (only its hash is stored) and trades it for
// short-lived access tokens (lib/mobileAuth.ts). Rotated on every refresh; signing out or closing the
// account deletes the row, which ends the session within the access token's lifetime.
model MobileSession {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  tokenHash    String   @unique
  // The hash before the last rotation. Seeing it again means the old token was copied, so the session ends.
  previousHash String?
  platform     String?
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([previousHash])
}

// An image a reader uploaded to UploadThing (lib/uploads.ts): an avatar, a banner or a book cover. Uploads
// stay on the uploader's own profile and shelf: nowhere shared (the catalogue, search, circles, lists)
// takes one, and deleting the account deletes them. A plain userId, cleared by lib/accountDeletion.ts.
model Upload {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // UploadThing's file key, the same under any of its URL forms.
  key       String   @unique
  url       String
  userId    String   @db.ObjectId
  // "avatar", "banner", "cover", or "image" when the uploader didn't say.
  kind      String   @default("image")
  createdAt DateTime @default(now())

  @@index([userId])
}

// An Expo push token for one install of the app. A token moves to whoever signs in on that phone.
model PushToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?   
  username      String?   @unique @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  // IANA zone (e.g. "Europe/London") reported by the browser; reading-streak days roll over at its midnight.
  timeZone      String?
  password      String?
  hashedPassword String?
  bio           String?
  image         String?
  banner         String?
  favColour     String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  favGenres String[] @db.String
  // Hid the genre picks ("Somewhere to start") on their own shelf (it still shows on Discover). Unset reads as shown.
  hideShelfPicks Boolean?
  favouriteIds String[] @db.String
  books Book[]
  accounts      Account[]
  sessions      Session[]
  readingGoals  ReadingGoal[]
  following     Follow[] @relation("UserFollows")
  followers     Follow[] @relation("UserFollowedBy")
  authorFollows AuthorFollow[]
  seriesFollows SeriesFollow[]
  activities    Activity[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  achievements  UserAchievement[]
  readingDays   ReadingDay[]
  // Staff access: READER, LIBRARIAN or ADMIN (packages/shared/src/roles.ts says what each may do). Unset
  // reads as READER. Set by an admin on /staff/users, or for the first admin by scripts/set-role.ts.
  role          String?
  // The role whose welcome this account has seen (packages/shared/src/roleWelcome.ts). Cleared when an admin
  // changes the role, so a new role is welcomed the next time the app loads.
  roleWelcomedAs String?
  // The old staff flag, before roles. Read only: scripts/set-role.ts --migrate turns it into ADMIN.
  isStaff       Boolean @default(false)
  // Suspended by an admin (lib/suspension.ts). Signed out everywhere and unable to sign in while
  // suspendedAt is set and suspendedUntil is unset (indefinite) or still ahead.
  suspendedAt      DateTime?
  suspendedUntil   DateTime?
  suspensionReason String?
  suspendedById    String? @db.ObjectId
  lists         List[]
  listReports   ListReport[]
  // Privacy. Optional so accounts made before these existed read as the defaults
  // (PUBLIC, EVERYONE, false, false). lib/privacy.ts normalizes them and enforces every rule.
  profileVisibility ProfileVisibility?
  reviewVisibility  ReviewVisibility?
  hideWantToRead    Boolean?
  hideFollowCounts  Boolean?
  // Keep favourites off the profile for everyone else. Unset shows them (privacyRules.ts).
  hideFavourites    Boolean?
  // A librarian hiding their Librarian badge (packages/shared/src/staffBadge.ts). The team's badge always shows.
  hideStaffBadge    Boolean?
  // Community preferences, optional for the same reason (EVERYONE, false, PRIVATE). See lib/preferences.ts.
  buddyReadInvites      BuddyReadInviteAudience?
  // Reveal reviews marked as spoilers instead of covering them.
  showSpoilers          Boolean?
  // What a new list starts as in the editor.
  defaultListVisibility ListVisibility?
  // Ask the shelf and Catch me up recaps (lib/preferences.ts aiFeatures). Unset reads as off on free and
  // on on Plus.
  aiFeatures            Boolean?
  // The old recaps switch, before aiFeatures. Read only: a Plus reader who switched it off stays off.
  showRecaps            Boolean?
  blocking      Block[] @relation("UserBlocks")
  blockedBy     Block[] @relation("UserBlockedBy")
  // Bookmark Plus. Stripe's webhook (app/api/billing/webhook) is the only writer of these; lib/entitlements.ts
  // turns the plan into what the account may do. Optional like the other later fields: accounts made
  // before billing have no value stored, and planOf() reads that as FREE. New accounts get FREE.
  plan                 Plan?     @default(FREE)
  // When the current paid or trial period ends. Informational: the webhook moves `plan`.
  planRenewsAt         DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Set once a trial has been used, so a second Checkout doesn't grant another.
  trialEndsAt          DateTime?
  // Subscribed at the Founding Reader price (lib/entitlements.ts FOUNDING). Set by the webhook, never
  // cleared, and counted against the founding cap. Shows a Founding badge while on Plus.
  foundingMember       Boolean?
  // Bought the one-time lifetime Plus (no longer sold). Plus for good; subscription events
  // never downgrade it. Cleared only by a full refund or a dispute of that payment.
  lifetime             Boolean?
  // On the Patron yearly price (no longer offered): same features, a Patron badge. Follows the subscription.
  patron               Boolean?
  // Free Plus until this date (from referrals and gift codes before launch, or set by staff). No Stripe subscription.
  compPlusUntil        DateTime?
  // Plus bought in the iOS or Android app, through RevenueCat (app/api/billing/revenuecat). Kept apart
  // from the Stripe fields so neither store's events can end the other's subscription. storePlusUntil is
  // when the store says access ends (null on free); storeName is APP_STORE or PLAY_STORE.
  storePlusUntil       DateTime?
  storeName            String?
  storeProductId       String?
  storeTrialing        Boolean?
  // Push notification groups the reader switched off (lib/push.ts PUSH_GROUPS). Unset reads as all on.
  pushOff              String[] @db.String
  mobileSessions       MobileSession[]
  pushTokens           PushToken[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

enum Plan {
  FREE
  PLUS
}

enum ProfileVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum ReviewVisibility {
  EVERYONE
  FOLLOWERS
  ONLY_ME
}

// Who can invite this reader to a reading circle by username. The invite link always works.
enum BuddyReadInviteAudience {
  EVERYONE
  // Only readers they follow.
  FOLLOWING
  NOBODY
}

// blockerId has blocked blockedId. Either direction hides the two from each other (lib/privacy.ts).
model Block {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  blockerId String @db.ObjectId
  blockedId String @db.ObjectId
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  // One block per pair. The prefix covers "who have I blocked" (blockerId alone).
  @@unique([blockerId, blockedId])
  // "Who has blocked me": search and feed filtering, and the cascade from a deleted user.
  @@index([blockedId])
}

model Follow {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  followerId String @db.ObjectId
  followingId String @db.ObjectId
  createdAt DateTime @default(now())

  follower User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  // Followers list: followingId match, newest first. (followerId lookups use the unique index.)
  @@index([followingId, createdAt])
}

// A reader following an author (lib/authorFollows.ts). Keyed by the Open Library author key, which stays
// put when the name on a copy is spelled differently. Name and slug are as they were when followed, for
// the "Authors you follow" list. Authors don't have accounts: the page and the follow are ours.
model AuthorFollow {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  authorKey String
  name String
  slug String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, authorKey])
  // Everyone following an author, for telling them about a new book later.
  @@index([authorKey])
}

// A reader following a series (lib/seriesFollows.ts), keyed by its name and first author
// (packages/shared/src/series.ts seriesKey). Name and author are kept as the catalog spelt them when
// followed, for the tracker. Free for everyone.
model SeriesFollow {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  seriesKey String
  name String
  author String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesKey])
  // Everyone following a series, for telling them about a new book later.
  @@index([seriesKey])
}

model ReadingGoal {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  year Int
  targetBooks Int
  // Plus goals (lib/entitlements.ts: extraGoalTypes). Null means not set; a free account keeps what it set while on Plus.
  targetPages Int?
  targetBooksPerMonth Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

model VerificationToken {
  id String  @id @default(auto()) @map("_id") @db.ObjectId
  identifier String  
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id String   @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  title String
  author String
  description String?
  coverImage String
  cardColour String?
  status Status @default(NOT_STARTED)
  genre String?
  // 0.25 to 5 in quarter-star steps (lib/readHistory.ts ratingSchema).
  rating Float?
  // The reader's own filing labels ("owned", "kindle", "book-club-2023"), private to them. Imported from
  // Goodreads shelves and StoryGraph tags, written back out as "Bookshelves". Not ReaderTags, which
  // describe the work for everyone.
  tags String[] @db.String
  review String?
  // The review gives the plot away: others see it collapsed behind a click-to-reveal.
  reviewSpoiler Boolean?
  // Only the reader sees this review, whatever their review visibility setting.
  reviewPrivate Boolean?
  // Staff took the review down after a report (lib/staffReports.ts): only the reader still sees the text.
  // Stays set when they edit it, until staff lift it. Their own copy, stats and export are untouched.
  reviewHiddenAt DateTime?
  // Staff also took the rating out of the book's average and every "people you follow" signal.
  ratingHiddenAt DateTime?
  // A private copy: only the reader sees it, whatever shelf it's on. Left off their profile, the feed, Wrapped
  // as others see it, and every "people you follow" signal (lib/privacy.ts sharedBookWhere). Unset is shared.
  isPrivate Boolean?
  // Completed reads. Kept in step with BookRead rows whose status is COMPLETED.
  timesRead Int @default(0)
  notes Note[]
  // 0 is allowed for an audiobook whose print length nobody knows; progress then runs on minutes.
  pages Int
  currentPage Int? @default(0)
  // Audiobooks: progress is logged as minutes listened out of the edition's running time instead of
  // pages (lib/progress.ts). Unset means PAGES. audioMinutes is copied from the Edition so per-reader
  // queries don't need a join; currentMinute mirrors the open read the way currentPage does.
  progressUnit ProgressUnit?
  audioMinutes Int?
  currentMinute Int?
  // Kindle readers log a percent, not a page. currentPercent is the exact percent typed (the page or
  // minute above is set to match when the length is known, so pace and stats keep working); null when
  // the place was last logged in pages or minutes. logsPercent remembers the reader's choice per book.
  currentPercent Float?
  logsPercent Boolean?
  createdAt DateTime @default(now())
  // These mirror the current (or latest) read so existing queries keep working; BookRead holds the history.
  startedAt DateTime?
  completedAt DateTime?
  // When the book was put down: set while DNF or PAUSED, cleared otherwise. A DNF's page is currentPage.
  stoppedAt DateTime?
  // The reader's last progress update (start, progress, resume). Unset on books not updated since this
  // existed; lib/recap.ts falls back to startedAt to tell a book left untouched for a while.
  progressAt DateTime?
  // Open Library work key (e.g. OL45883W), so the same book can be matched across readers and lists.
  workKey String?
  // The shared catalog (Work and Edition below). Optional while rows shelved before the catalog existed
  // are backfilled (scripts/backfill-catalog.ts); title, author, cover and pages above stay the reader's
  // own copy, so every existing query keeps working.
  workId String? @db.ObjectId
  editionId String? @db.ObjectId
  // Who put this book on the reader's radar, seen only by the reader: a Bookmark user (set when the book
  // was added from a recommendation) or a free-text name for someone who isn't on Bookmark.
  recommendedById String? @db.ObjectId
  recommendedByName String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  edition Edition? @relation(fields: [editionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activities Activity[]
  reads BookRead[]

  // Shelf (userId) and public profile (userId + status in STARTED/COMPLETED). The prefix covers userId alone.
  @@index([userId, status])
  // "Picked by people you follow" in book details: this book on followed readers' shelves.
  @@index([workKey, userId])
  // The same, keyed on the catalog: every reader of a work, and every reader of one edition.
  @@index([workId, userId])
  @@index([editionId])
}

// ---- Shared catalog -------------------------------------------------------------------------
// One Work per book (what Open Library calls a work: "Dune"), one Edition per printing of it (the 2019
// Ace paperback, the audiobook). Shared by every reader: two readers adding the same ISBN point at the
// same Edition, and two editions of one book point at the same Work. lib/catalog.ts is the only writer.

enum EditionFormat {
  PAPERBACK
  HARDCOVER
  EBOOK
  AUDIOBOOK
}

model Work {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  // Identity, always set: "ol:OL45883W" for an Open Library work, or "title:<normalised title>|<normalised author>"
  // for a book nobody could match. Required so the unique index needs no sparse handling of nulls.
  key String @unique
  // Open Library work key (OL45883W), when known. Null for manual entries.
  openLibraryKey String?
  // Hardcover's book id, for a book first added from a Hardcover search hit (lib/hardcover.ts). With no
  // Open Library key, this is what gives the work a book page (lib/bookPage.ts): a hand-typed work has neither.
  hardcoverId String?
  title String
  authors String[] @db.String
  // Open Library author keys (OL7477772A), in step with `authors` where Open Library had them. The
  // stable identity author pages (lib/authors.ts) look works up by, and that following an author will build on.
  authorKeys String[] @db.String
  description String?
  // Open Library subjects, capped, as the seed for genres and (later) mood search.
  subjects String[] @db.String
  seriesName String?
  // 1, 2, 2.5…
  seriesPosition Float?
  // When Hardcover was last asked for the work's series (lib/seriesFill.ts), so a standalone isn't asked
  // about every time someone shelves it.
  seriesCheckedAt DateTime?
  coverUrl String?
  firstPublishYear Int?
  // Fields a librarian corrected (title, authors, description, coverUrl). lib/catalog never overwrites them.
  curatedFields String[] @db.String
  // Open Library's counts for the work, for the recaps popularity gate (lib/recap.ts isWellKnown).
  // Filled on first need and refreshed when popularityCheckedAt is a month old.
  olEditionCount Int?
  olRatingsCount Int?
  olReadingLogCount Int?
  popularityCheckedAt DateTime?
  // "<author slug>|<title key>": the first author and the title once case, series suffixes, edition tags
  // and a leading article are set aside (lib/catalog/normalise.ts workMatchKey). A new book with no exact
  // key match is filed under an existing work with the same match key instead of a duplicate. Filled for
  // older rows by scripts/backfill-work-match-keys.ts.
  matchKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editions Edition[]
  books Book[]
  readerTags ReaderTags[]

  @@index([openLibraryKey])
  @@index([hardcoverId])
  @@index([authorKeys])
  @@index([matchKey])
}

// ---- Moods and content warnings -----------------------------------------------------------
// What a book feels like and what's in it, from the readers who've finished it. One row per reader per
// Work (tagged at review time); the book page shows the aggregate (lib/workTags.ts). userId is a
// scalar, not a relation, so User stays untouched; rows from deleted accounts are skipped when reading.

// StoryGraph's set, so a StoryGraph export's "Moods" column maps straight onto it.
enum Mood {
  ADVENTUROUS
  CHALLENGING
  DARK
  EMOTIONAL
  FUNNY
  HOPEFUL
  INFORMATIVE
  INSPIRING
  LIGHTHEARTED
  MYSTERIOUS
  REFLECTIVE
  TENSE
}

enum WarningLevel {
  MINOR
  MODERATE
  GRAPHIC
}

model ReaderTags {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  workId String @db.ObjectId
  userId String @db.ObjectId
  moods Mood[]
  // [{ "topic": "Sexual assault", "level": "GRAPHIC" }], topics from WARNING_TOPICS in lib/workTags.ts.
  warnings Json?
  // 0 to 5 (SPICE_MAX in lib/workTags.ts), only from a reader who finished the book. Unset: not reported.
  spice Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  // One set of tags per reader per work; the prefix covers loading a work's aggregate.
  @@unique([workId, userId])
  @@index([userId])
}

model Edition {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  workId String @db.ObjectId
  // Identity, always set: "ol:OL7353617M", else "isbn:<isbn13>", else "isbn10:<isbn10>", else
  // "generic:<workId>:<format>:<pages>" for a best guess with no identifier (backfilled and manual books).
  key String @unique
  // Open Library edition key (OL7353617M), when known.
  openLibraryKey String?
  isbn10 String?
  isbn13 String?
  format EditionFormat?
  pages Int?
  // Audiobooks: running time.
  audioMinutes Int?
  publisher String?
  publishedYear Int?
  coverUrl String?
  // Fields a librarian corrected (pages, coverUrl). lib/catalog never overwrites them.
  curatedFields String[] @db.String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  books Book[]

  // A work's editions.
  @@index([workId])
  // Resolving by identifier (lib/catalog.ts). Plain indexes: uniqueness is the key above.
  @@index([openLibraryKey])
  @@index([isbn13])
  @@index([isbn10])
}

model Note {
  id String   @id @default(auto()) @map("_id") @db.ObjectId
  bookId String @db.ObjectId
  title String?
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

enum Status {
  STARTED
  NOT_STARTED
  COMPLETED
  // Did not finish: stopped for good, at currentPage on stoppedAt.
  DNF
  // On hold: keeps currentPage and can be resumed.
  PAUSED
  // Will not read: kept so the book isn't suggested or re-added by accident. Never posted, counted or shown to others.
  NOT_INTERESTED
}

// What a read's progress is counted in. PAGES is the default for every read made before this existed.
enum ProgressUnit {
  PAGES
  // Minutes listened, out of the edition's audioMinutes.
  MINUTES
}

// One row per time a reader picks a book up. "Read again" closes the current read and opens a new one,
// so earlier dates and ratings survive. Book.status/startedAt/completedAt/timesRead mirror these rows.
model BookRead {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  bookId String @db.ObjectId
  // Copied from the book so per-reader queries (stats, Wrapped, export) don't need a join. A scalar,
  // not a relation, so User is untouched: reads go with their book, and books go with their user.
  userId String @db.ObjectId
  // Null for a past read shelved as Finished without dates (and for reads backfilled from those).
  startedAt DateTime?
  // Set when the read ends: COMPLETED or DNF. Null while STARTED or PAUSED, and for undated past reads.
  finishedAt DateTime?
  // STARTED, PAUSED, COMPLETED or DNF. A read is never NOT_STARTED.
  status Status
  // The rating given for this read. Book.rating is the reader's current rating.
  rating Float?
  // For a DNF, the page the reader stopped at.
  stoppedAtPage Int?
  // Audiobook reads: the unit, the edition's running time when the read was open, and how far the
  // reader got in minutes (kept up to date while the read is open; final once it ends). Book mirrors
  // the open read's values. Unset on reads made before this existed, which are all in pages.
  progressUnit ProgressUnit?
  audioMinutes Int?
  currentMinute Int?
  // For a DNF of an audiobook, the minute the reader stopped at.
  stoppedAtMinute Int?
  // The percent the reader logged, when they logged one (Book.currentPercent): kept up to date while
  // the read is open, final on a DNF.
  currentPercent Float?
  // The book's page count when this read ended, stamped with progressUnit and audioMinutes above, so
  // stats and Wrapped count each read in the format and length it was read in (lib/progress.ts
  // readLength). Unset on reads that ended before this existed: those follow the book until an edit
  // to its format or length stamps them (readLengthsAfterEdit).
  pages Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // A book's reads in order, and finding its open one. The prefix covers the cascade from a deleted book.
  @@index([bookId, createdAt])
  // Stats, Wrapped and the goal: a reader's reads finished in a date range.
  @@index([userId, finishedAt])
  // A reader's reads by outcome (every DNF, every re-read), and import de-duplication.
  @@index([userId, status])
}

model Activity {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  bookId String? @db.ObjectId
  type ActivityType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Feed: activity from followed users, newest first.
  @@index([userId, createdAt])
  // Lets the cascade from a deleted book find its activity without a collection scan.
  @@index([bookId])
}

enum ActivityType {
  ADDED_BOOK
  STARTED_BOOK
  COMPLETED_BOOK
  RATED_BOOK
  REVIEWED_BOOK
  // Gave up on a book. Pausing isn't posted: it's a private, temporary state.
  DNF_BOOK
}

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  actorId String @db.ObjectId
  type NotificationType
  bookId String? @db.ObjectId
  achievementKey String?
  // Reading circle notifications: which reading circle, and how many joins or unlocked comments one row stands for.
  buddyReadId String? @db.ObjectId
  count Int?
  // BOOK_RECOMMENDED: the sender's optional note. bookId is the sender's own copy of the book.
  message String?
  read Boolean @default(false)
  createdAt DateTime @default(now())

  user  User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Bell: unread count and mark-all-read (userId + read), and the list (userId, sorted by createdAt).
  @@index([userId, read, createdAt])
}

enum NotificationType {
  NEW_FOLLOWER
  ACHIEVEMENT_EARNED
  // A member asked you to read along.
  BUDDY_READ_INVITE
  // Someone joined a reading circle you host. Unread ones are batched: count says how many joined.
  BUDDY_READ_JOINED
  // Comments you can now read: your progress passed other members' comments, or someone posted at or before
  // where you'd already read (BOO-43). Batched per reading circle: count says how many.
  COMMENTS_UNLOCKED
  // The host left and handed you the reading circle. actorId is the old host.
  BUDDY_READ_HOSTED
  // The host closed their account and the reading circle passed to you. actorId is you (the old host is gone);
  // if you had no room it arrived archived.
  BUDDY_READ_HOST_INHERITED
  // Someone asked to follow your followers-only or private profile (lib/followRequests.ts).
  FOLLOW_REQUEST
  // You finished a seasonal quest (cut before launch; old rows are left out of the bell).
  QUEST_COMPLETED
  // A friend (someone you both follow) sent you a book, with an optional message.
  BOOK_RECOMMENDED
  // Staff hid your review after a report. actorId is you, so no librarian is named; bookId is your copy.
  REVIEW_HIDDEN
}

model UserAchievement {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  key String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// A calendar day (in the reader's time zone) on which they logged reading: a page update or a
// finished book. One row per day, so reading streaks don't need to scan every Activity row.
model ReadingDay {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  // "YYYY-MM-DD", so it sorts and compares as text.
  day String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

enum ListVisibility {
  PRIVATE
  PUBLIC
}

model List {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  ownerId String @db.ObjectId
  title String
  description String?
  visibility ListVisibility @default(PRIVATE)
  // Team-curated "Bookmark Picks". Only staff can set this, along with the featured window and hidden.
  isPick Boolean @default(false)
  genres String[] @db.String
  tags String[] @db.String
  featuredFrom DateTime?
  featuredUntil DateTime?
  featuredLabel String?
  hidden Boolean @default(false)
  // Editors' choice: a librarian or admin chose this reader's list to lead its genres' pages on Discover
  // (lib/genreLists.ts), ahead of the lists picked automatically. Unset is not chosen.
  chosenAt DateTime?
  chosenById String? @db.ObjectId
  // Set when the list was copied ("remixed") from someone else's public list. A plain id, not a
  // relation, so deleting the original leaves its remixes alone.
  forkedFromId String? @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items ListItem[]
  reports ListReport[]

  // A reader's own lists, most recently updated first. The prefix covers ownerId alone (counts, ownership checks).
  @@index([ownerId, updatedAt])
  // Browsing and the sitemap: public, not hidden, most recently updated first.
  @@index([visibility, hidden, updatedAt])
  // A list's remix count.
  @@index([forkedFromId])
}

// One report per reader per list. Staff review reported lists and use `hidden` to take one down.
model ListReport {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  listId String @db.ObjectId
  reporterId String @db.ObjectId
  reason String
  createdAt DateTime @default(now())
  // The staff reports queue (/staff/reports): OPEN until a librarian or admin resolves it. Unset reads as OPEN.
  status String?
  resolvedById String? @db.ObjectId
  resolvedAt DateTime?
  resolutionNote String?

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([listId, reporterId])
}

// Items snapshot the book's details: books are per-user rows, so there's no shared record to point at.
model ListItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  listId String @db.ObjectId
  workKey String?
  title String
  author String
  coverUrl String?
  pages Int?
  // The curator's reason: "why you'd like this".
  note String?
  // Who wrote the note when it isn't the list's owner: a remix keeps the original curator's reasons.
  // Unset means the owner. A plain id, so a deleted account just falls back to the owner.
  noteAuthorId String? @db.ObjectId
  position Int
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  // Items are always loaded per list in position order.
  @@index([listId, position])
  // "From people you follow" on Discover: newest additions to followed readers' lists.
  @@index([listId, createdAt])
  // "Picked by people you follow" in book details.
  @@index([workKey])
}

// A library import from a Goodreads, StoryGraph or Bookmark CSV export. The file is parsed once on upload;
// Open Library matching and inserting then run in short batches that the /import page drives, so no
// request comes near a serverless time limit. userId is a scalar, not a relation, so User is untouched;
// rows are cleared once the import finishes, leaving only the summary.
model ImportJob {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  // goodreads, storygraph or bookmark.
  source String
  fileName String?
  // matching → ready → importing → done, or cancelled.
  status String @default("matching")
  // ImportRow[] (lib/import/types.ts).
  rows Json
  // { "<row index>": ImportMatch | null } for every row looked up so far (null: no match).
  matches Json
  // A book id per row, chosen up front so a retried batch finds its books instead of inserting them twice.
  bookIds String[]
  // Rows before this index have been imported or skipped.
  importCursor Int @default(0)
  // Index into bookIds up to which covers have been copied to UploadThing (after the import).
  coverCursor Int @default(0)
  // Running counts while importing, then the summary.
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The reader's latest job, for resuming after a reload.
  @@index([userId, createdAt])
}

// ---- Reading circles ---------------------------------------------------------------------------
// Reading one book together. Each member reads their own shelf Book (editions differ, so progress is a
// percent), and comments are pinned to a percent and stay locked until a reader gets there.
// Users and Books are referenced by scalar ids, not relations, so those models stay untouched:
// lookups go through the indexes below, and a missing user or book is skipped when reading.

enum BuddyReadStatus {
  ACTIVE
  FINISHED
  ARCHIVED
}

model BuddyRead {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  // A snapshot of the host's book, so the invite page and joiners don't depend on anyone's shelf.
  workKey String?
  title String
  author String
  coverImage String?
  cardColour String?
  // The host's edition, used as the page count when a joiner gets the book added to their shelf.
  pages Int
  // And its running time when the host listens: a joiner's new shelf copy keeps the same scale.
  audioMinutes Int?
  hostId String @db.ObjectId
  // Set when hosting was handed on (the host left or closed their account). Inherited circles don't count
  // against the host's own limit; they have a separate cap (lib/buddyReads.ts INHERITED_HOSTING_LIMIT).
  inheritedAt  DateTime?
  startsAt DateTime
  // Optional reading plan: [{ label: "Chapters 1-5", until: 20, due: "2026-11-01" }], until being a percent.
  schedule Json?
  status BuddyReadStatus @default(ACTIVE)
  inviteCode String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members BuddyReadMember[]
  comments BuddyReadComment[]
  invites BuddyReadInvite[]

  // Hosted reading circles (the medal, and the host's list).
  @@index([hostId, createdAt])
}

model BuddyReadMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  buddyReadId String @db.ObjectId
  userId String @db.ObjectId
  // The member's own shelf Book; their progress is its currentPage / pages.
  bookId String @db.ObjectId
  joinedAt DateTime @default(now())
  // The furthest percent this member has been told about, so unlock notifications never repeat.
  notifiedProgress Float @default(0)
  // When their book first reached 100%.
  finishedAt DateTime?
  // Set while they've muted the circle: no comment notifications, bell or push. Unset reads as not muted.
  mutedAt DateTime?
  // When they last had the circle open, so a comment posted while they're reading it isn't pushed too.
  lastSeenAt DateTime?

  buddyRead BuddyRead @relation(fields: [buddyReadId], references: [id], onDelete: Cascade)

  // One membership each. The prefix covers the buddyReadId foreign key.
  @@unique([buddyReadId, userId])
  // "My reading circles", and the finished-a-reading-circle medal.
  @@index([userId, joinedAt])
  // A progress update finds the reading circles its book belongs to.
  @@index([bookId])
}

model BuddyReadComment {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  buddyReadId String @db.ObjectId
  userId String @db.ObjectId
  // Percent through the book, 0-100. Readers below it get a locked stub with no body.
  position Float
  pageLabel String?
  chapterLabel String?
  body String
  // One level of replies: a reply's parent is always a top-level comment.
  parentId String? @db.ObjectId
  createdAt DateTime @default(now())
  editedAt DateTime?
  // Soft delete, so replies keep their place. The body is cleared.
  deletedAt DateTime?

  buddyRead BuddyRead @relation(fields: [buddyReadId], references: [id], onDelete: Cascade)
  parent BuddyReadComment? @relation("BuddyReadCommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies BuddyReadComment[] @relation("BuddyReadCommentReplies")
  reactions BuddyReadReaction[]
  reports BuddyReadCommentReport[]

  // The timeline, in reading order; the prefix covers the buddyReadId foreign key.
  @@index([buddyReadId, position])
  @@index([userId])
  @@index([parentId])
}

model BuddyReadReaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  commentId String @db.ObjectId
  userId String @db.ObjectId
  // One of BUDDY_READ_EMOJI in lib/buddyReads.ts.
  emoji String
  createdAt DateTime @default(now())

  comment BuddyReadComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // One of each emoji per reader per comment; the prefix covers the commentId foreign key.
  @@unique([commentId, userId, emoji])
  @@index([userId])
}

// Like ListReport: one report per reader per comment, with a fixed reason.
model BuddyReadCommentReport {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  commentId String @db.ObjectId
  reporterId String @db.ObjectId
  reason String
  createdAt DateTime @default(now())
  // The staff reports queue (/staff/reports): OPEN until a librarian or admin resolves it. Unset reads as OPEN.
  status String?
  resolvedById String? @db.ObjectId
  resolvedAt DateTime?
  resolutionNote String?

  comment BuddyReadComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([reporterId])
}

// An in-app invite to a named reader (the invite link needs none). Shown on /buddy-reads until they join.
model BuddyReadInvite {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  buddyReadId String @db.ObjectId
  inviterId String @db.ObjectId
  inviteeId String @db.ObjectId
  createdAt DateTime @default(now())

  buddyRead BuddyRead @relation(fields: [buddyReadId], references: [id], onDelete: Cascade)

  @@unique([buddyReadId, inviteeId])
  @@index([inviteeId, createdAt])
  @@index([inviterId])
}

// A reader the host removed from a reading circle. They can't rejoin through the invite link; an invite
// from the host lifts it. Plain ids (no relation), like the other circle rows that name a user.
model BuddyReadRemoval {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  buddyReadId String   @db.ObjectId
  userId      String   @db.ObjectId
  removedAt   DateTime @default(now())

  @@unique([buddyReadId, userId])
  @@index([userId])
}

// ---- Follow requests --------------------------------------------------------------------------
// Following a reader whose profile isn't public (Followers only or Private) needs their approval: the
// follow is held here until they accept or decline (lib/followRequests.ts). Users are referenced by
// scalar ids, like the reading-circle models, so User stays untouched; account deletion clears both sides.
model FollowRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String   @db.ObjectId
  targetId    String   @db.ObjectId
  createdAt   DateTime @default(now())

  // One pending request per pair; the prefix covers "requests I've sent".
  @@unique([requesterId, targetId])
  // The owner's pending requests, newest first.
  @@index([targetId, createdAt])
}

// How often a reader used a metered AI feature in one period (lib/ai/usage.ts). One row per reader,
// feature and period, counted up with a conditional increment so two requests can't both spend the
// last of an allowance. Monthly rows: feature is an allowance key ("askShelfSearches", "recaps") and
// period the month in the reader's time zone ("2026-10"). The daily cost guard: feature "all" and
// period the local day ("2026-10-22").
model AiUsage {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  feature String
  period String
  count Int @default(0)
  updatedAt DateTime @updatedAt

  // The counter itself; the prefix covers a reader's rows.
  @@unique([userId, feature, period])
}

// ---- Catch me up -------------------------------------------------------------------------------
// AI recaps (lib/recap.ts). Private to the reader: never in the feed, lists or circles. One row per
// reader, work, kind and bucket, so reopening a recap is free. userId is a scalar, like ReaderTags.

enum RecapKind {
  // The earlier books of a series the reader finished, when they start a later one.
  SERIES
  // The book so far, when they come back to it.
  RESUME
}

enum RecapVote {
  UP
  DOWN
}

model Recap {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  workId String @db.ObjectId
  // The shelf book it was asked for from.
  bookId String @db.ObjectId
  kind RecapKind
  // RESUME: the percent the recap stops at, a multiple of RECAP_BUCKET. SERIES: how many earlier books it covers.
  bucket Int
  // False when the model said it doesn't know the book well enough. Kept so asking again is free.
  confident Boolean
  paragraphs String[]
  // RESUME: the furthest point the model says it described. Never above bucket (otherwise it isn't stored).
  reachedPercent Float?
  // Works of the earlier books (SERIES).
  coveredWorkIds String[] @db.ObjectId
  model String
  // The reader's thumbs up or down, for quality tracking.
  vote RecapVote?
  votedAt DateTime?
  createdAt DateTime @default(now())

  // The cache key; the prefix covers a reader's recaps.
  @@unique([userId, workId, kind, bucket])
}

// A reader's report that a book's cover or details are wrong. Points at the shared catalogue (lib/catalog),
// which is what a librarian fixes. Plain ids, so the report outlives the reader's copy.
model BookReport {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  workId String @db.ObjectId
  editionId String? @db.ObjectId
  reporterId String @db.ObjectId
  // cover, details or other (lib/staffReports.ts BOOK_REPORT_REASONS).
  reason String
  note String?
  createdAt DateTime @default(now())
  // The staff reports queue (/staff/reports): OPEN until a librarian or admin resolves it. Unset reads as OPEN.
  status String?
  resolvedById String? @db.ObjectId
  resolvedAt DateTime?
  resolutionNote String?

  @@unique([workId, reporterId])
  @@index([status, createdAt])
}

// A reader's report of someone's review. The review lives on the reviewer's copy (Book), so bookId is that
// copy. Plain ids, so the report and its excerpt (the text as reported) outlive an edit or a deleted copy.
model ReviewReport {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  bookId String @db.ObjectId
  reviewerId String @db.ObjectId
  reporterId String @db.ObjectId
  // One of REVIEW_REPORT_REASONS (packages/shared/src/reviewReports.ts).
  reason String
  note String?
  excerpt String?
  createdAt DateTime @default(now())
  // The staff reports queue (/staff/reports), as on the other report rows. Unset reads as OPEN.
  status String?
  resolvedById String? @db.ObjectId
  resolvedAt DateTime?
  resolutionNote String?

  @@unique([bookId, reporterId])
  @@index([status, createdAt])
}

// Every change made through the staff tools, newest first on /staff/log. Written by lib/staffLog.ts in the
// same request as the change. Plain ids, so deleting an account leaves the record.
model StaffAction {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  actorId String @db.ObjectId
  // e.g. user.suspend, plus.grant, role.set, work.edit, report.dismiss (lib/staffLog.ts StaffActionKind).
  action String
  // user, work, edition, list, comment or report.
  targetType String
  targetId String
  before Json?
  after Json?
  reason String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}
