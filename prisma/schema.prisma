// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.String
  access_token       String?  @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String  @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?   
  username      String?   @unique @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  // IANA zone (e.g. "Europe/London") reported by the browser; reading-streak days roll over at its midnight.
  timeZone      String?
  password      String?
  hashedPassword String?
  bio           String?
  image         String?
  banner         String?
  favColour     String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  favGenres String[] @db.String
  favouriteIds String[] @db.String
  books Book[]
  accounts      Account[]
  sessions      Session[]
  readingGoals  ReadingGoal[]
  following     Follow[] @relation("UserFollows")
  followers     Follow[] @relation("UserFollowedBy")
  activities    Activity[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  achievements  UserAchievement[]
  readingDays   ReadingDay[]
  isStaff       Boolean @default(false)
  lists         List[]
  listReports   ListReport[]
}

model Follow {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  followerId String @db.ObjectId
  followingId String @db.ObjectId
  createdAt DateTime @default(now())

  follower User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])

  // Followers list: followingId match, newest first. (followerId lookups use the unique index.)
  @@index([followingId, createdAt])
}

model ReadingGoal {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  year Int
  targetBooks Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

model VerificationToken {
  id String  @id @default(auto()) @map("_id") @db.ObjectId
  identifier String  
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id String   @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  title String
  author String
  description String?
  coverImage String
  cardColour String?
  status Status @default(NOT_STARTED)
  genre String?
  // 0.5 to 5 in half-star steps.
  rating Float?
  review String?
  // Completed reads. Kept in step with BookRead rows whose status is COMPLETED.
  timesRead Int @default(0)
  notes Note[]
  pages Int
  currentPage Int? @default(0)
  createdAt DateTime @default(now())
  // These mirror the current (or latest) read so existing queries keep working; BookRead holds the history.
  startedAt DateTime?
  completedAt DateTime?
  // When the book was put down: set while DNF or PAUSED, cleared otherwise. A DNF's page is currentPage.
  stoppedAt DateTime?
  // Open Library work key (e.g. OL45883W), so the same book can be matched across readers and lists.
  workKey String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  reads BookRead[]

  // Shelf (userId) and public profile (userId + status in STARTED/COMPLETED). The prefix covers userId alone.
  @@index([userId, status])
}
model Note {
  id String   @id @default(auto()) @map("_id") @db.ObjectId
  bookId String @db.ObjectId
  title String?
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

enum Status {
  STARTED
  NOT_STARTED
  COMPLETED
  // Did not finish: stopped for good, at currentPage on stoppedAt.
  DNF
  // On hold: keeps currentPage and can be resumed.
  PAUSED
}

// One row per time a reader picks a book up. "Read again" closes the current read and opens a new one,
// so earlier dates and ratings survive. Book.status/startedAt/completedAt/timesRead mirror these rows.
model BookRead {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  bookId String @db.ObjectId
  // Copied from the book so per-reader queries (stats, Wrapped, export) don't need a join. A scalar,
  // not a relation, so User is untouched: reads go with their book, and books go with their user.
  userId String @db.ObjectId
  // Null for a past read shelved as Finished without dates (and for reads backfilled from those).
  startedAt DateTime?
  // Set when the read ends: COMPLETED or DNF. Null while STARTED or PAUSED, and for undated past reads.
  finishedAt DateTime?
  // STARTED, PAUSED, COMPLETED or DNF. A read is never NOT_STARTED.
  status Status
  // The rating given for this read. Book.rating is the reader's current rating.
  rating Float?
  // For a DNF, the page the reader stopped at.
  stoppedAtPage Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // A book's reads in order, and finding its open one. The prefix covers the cascade from a deleted book.
  @@index([bookId, createdAt])
  // Stats, Wrapped and the goal: a reader's reads finished in a date range.
  @@index([userId, finishedAt])
  // A reader's reads by outcome (every DNF, every re-read), and import de-duplication.
  @@index([userId, status])
}

model Activity {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  bookId String? @db.ObjectId
  type ActivityType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Feed: activity from followed users, newest first.
  @@index([userId, createdAt])
  // Lets the cascade from a deleted book find its activity without a collection scan.
  @@index([bookId])
}

enum ActivityType {
  ADDED_BOOK
  STARTED_BOOK
  COMPLETED_BOOK
  RATED_BOOK
  REVIEWED_BOOK
  // Gave up on a book. Pausing isn't posted: it's a private, temporary state.
  DNF_BOOK
}

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  actorId String @db.ObjectId
  type NotificationType
  bookId String? @db.ObjectId
  achievementKey String?
  read Boolean @default(false)
  createdAt DateTime @default(now())

  user  User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Bell: unread count and mark-all-read (userId + read), and the list (userId, sorted by createdAt).
  @@index([userId, read, createdAt])
}

enum NotificationType {
  NEW_FOLLOWER
  ACHIEVEMENT_EARNED
}

model UserAchievement {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  key String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// A calendar day (in the reader's time zone) on which they logged reading: a page update or a
// finished book. One row per day, so reading streaks don't need to scan every Activity row.
model ReadingDay {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  // "YYYY-MM-DD", so it sorts and compares as text.
  day String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

enum ListVisibility {
  PRIVATE
  PUBLIC
}

model List {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  ownerId String @db.ObjectId
  title String
  description String?
  visibility ListVisibility @default(PRIVATE)
  // Team-curated "Bookmark Picks". Only staff can set this, along with the featured window and hidden.
  isPick Boolean @default(false)
  genres String[] @db.String
  tags String[] @db.String
  featuredFrom DateTime?
  featuredUntil DateTime?
  featuredLabel String?
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items ListItem[]
  reports ListReport[]

  // A reader's own lists, most recently updated first. The prefix covers ownerId alone (counts, ownership checks).
  @@index([ownerId, updatedAt])
  // Browsing and the sitemap: public, not hidden, most recently updated first.
  @@index([visibility, hidden, updatedAt])
}

// One report per reader per list. Staff review reported lists and use `hidden` to take one down.
model ListReport {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  listId String @db.ObjectId
  reporterId String @db.ObjectId
  reason String
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([listId, reporterId])
}

// Items snapshot the book's details: books are per-user rows, so there's no shared record to point at.
model ListItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  listId String @db.ObjectId
  workKey String?
  title String
  author String
  coverUrl String?
  pages Int?
  note String?
  position Int
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  // Items are always loaded per list in position order.
  @@index([listId, position])
}

// A library import from a Goodreads, StoryGraph or Bookmark CSV export. The file is parsed once on upload;
// Open Library matching and inserting then run in short batches that the /import page drives, so no
// request comes near a serverless time limit. userId is a scalar, not a relation, so User is untouched;
// rows are cleared once the import finishes, leaving only the summary.
model ImportJob {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  // goodreads, storygraph or bookmark.
  source String
  fileName String?
  // matching → ready → importing → done, or cancelled.
  status String @default("matching")
  // ImportRow[] (lib/import/types.ts).
  rows Json
  // { "<row index>": ImportMatch | null } for every row looked up so far (null: no match).
  matches Json
  // A book id per row, chosen up front so a retried batch finds its books instead of inserting them twice.
  bookIds String[]
  // Rows before this index have been imported or skipped.
  importCursor Int @default(0)
  // Index into bookIds up to which covers have been copied to UploadThing (after the import).
  coverCursor Int @default(0)
  // Running counts while importing, then the summary.
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The reader's latest job, for resuming after a reload.
  @@index([userId, createdAt])
}
